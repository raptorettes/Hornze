config_version=5

[application]

config/name="Hornse"
run/main_scene="uid://cck7h48uou84v"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="uid://4q335xxs2p"

[audio]

buses/default_bus_layout="uid://dxf1ghha2g0pb"
driver/driver="JACK"
driver/mix_rate=48000

[autoload]

PhantomCameraManager="uid://duq6jhf6unyis"
LitManager="*uid://brf2hvdtyyw3q"
JsBridge="*uid://d4lsgp2xomm3d"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_state_charts/plugin.cfg", "res://addons/maaacks_game_template/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

